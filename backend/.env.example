# Copy to `backend/.env` for local development. NEVER commit your real .env.
# On Render, set these in the dashboard (Environment) instead of using a file.

# --- Django ---
DJANGO_DEBUG=true
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# --- Calendar "secret link" token ---
# The unguessable token that gates calendar access. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CALENDAR_SHARE_TOKEN=

# --- Google Calendar (OAuth2, read-only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtain once with:  python manage.py google_auth
GOOGLE_REFRESH_TOKEN=
# "primary" = the account's main calendar, or a specific calendar id.
GOOGLE_CALENDAR_ID=primary

# --- Weather (Open-Meteo, no API key) ---
# Your location's coordinates (e.g. from https://www.latlong.net).
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TEMPERATURE_UNIT=fahrenheit

# --- Optional: Postgres for future stateful tools (SQLite is used if unset) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
